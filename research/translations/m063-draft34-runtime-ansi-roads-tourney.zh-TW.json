        "other_percent": 0,
        "controls": [],
        "mnemonics": [],
        "literal_ampersands": 0,
        "shortcuts": 0
      },
      "text_zh_tw": "但因怠慢信仰，精靈狂怒襲擊城鎮的樣子。",
      "text_cp950_bytes_len": 38,
      "text_cp950_hex": "a6fda65dabe5ba43ab48a5f5a141baebc646a867abe3c5a7c0bbabb0c2edaababccba46ca143",
