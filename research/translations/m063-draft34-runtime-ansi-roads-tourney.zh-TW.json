      "text_cp950_hex": "a8cfa5ceaabaaa5abeb9bb50c55daa6ba853a6b3adada8eea141a6fdaa5ab0abb77ca4f1c1c9a4a4a4a3afe0a641c1cab652b944a8e3b5a5a141bdd0aa60b74ea143",
