      "fits_capacity": true,
      "capacity_slack_bytes": 56,
      "review_status": "mona_approved_candidate_pending_site",
      "translation_method": "curated",
      "site_binding": "unconfirmed_candidate_adjacent_rdata",
      "note": "spirit_rumor"
    },
    {
